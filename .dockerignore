# Dependencies and build output are produced inside the image, never copied in.
node_modules
.next
out
build

# Git / CI metadata
.git
.gitignore
.github

# Secrets — supplied at runtime through the server's .env, never baked in.
.env
.env.*
!.env.example

# Server-side compose files are not part of the image.
deploy

# Local tooling / editor noise
.claude
.vscode
.idea
*.tsbuildinfo
npm-debug.log*
.DS_Store

# Docs
README.md
AGENTS.md
CLAUDE.md
