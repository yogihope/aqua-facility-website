DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/aqua_web"
NEXT_PUBLIC_SITE_URL="https://aquafacility.com"
NEXT_PUBLIC_ENV="development"

# Code that opens /admin (form submissions). Leave empty to lock the admin.
ADMIN_CODE=""

# Enquiry notification email over SMTP (optional — forms still store without it)
# Gmail: host smtp.gmail.com, port 465, and an App Password as SMTP_PASS.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
NOTIFY_EMAIL="operations@aquafacility.com"
